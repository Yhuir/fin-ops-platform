(0, 0, 0, 0.08) 0 4px 12px -10px;\n}\n.zone-success {\n  --ops-header: #f4faf7;\n  --ops-header-raised: #ffffff;\n  --ops-header-text: #1f3a29;\n  --ops-header-muted: #496b55;\n  --ops-brand: #2f6b3f;\n  --ops-brand-dark: #255532;\n  --ops-brand-soft: rgba(47, 107, 63, 0.1);\n  --ops-header-border: #cfe3d5;\n  --ops-zone-body: #f3f4f6;\n  --ops-row-band-a: #fff8e6;\n  --ops-row-band-b: #e7f3ff;\n  --ops-row-border-a: #ead7aa;\n  --ops-row-border-b: #b9d4ed;\n  --ops-row-divider-a: #ead7aa;\n  --ops-row-divider-b: #b9d4ed;\n  border-color: #d1d5db;\n  background: #f3f4f6;\n}\n.zone-warning {\n  --ops-header: #fff7e8;\n  --ops-header-raised: #ffffff;\n  --ops-header-text: #513a1f;\n  --ops-header-muted: #76582f;\n  --ops-brand: #b8752b;\n  --ops-brand-dark: #95591d;\n  --ops-brand-soft: rgba(184, 117, 43, 0.12);\n  --ops-header-border: #e8d2aa;\n  --ops-zone-body: #f3f4f6;\n  --ops-row-band-a: #fff8e6;\n  --ops-row-band-b: #e7f3ff;\n  --ops-row-border-a: #ead7aa;\n  --ops-row-border-b: #b9d4ed;\n  --ops-row-divider-a: #ead7aa;\n  --ops-row-divider-b: #b9d4ed;\n  border-color: #d1d5db;\n  background: #f3f4f6;\n}\n.zone-header {\n  position: relative;\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 12px 16px 12px 18px;\n  align-items: flex-start;\n  border-bottom: 1px solid var(--ops-header-border, var(--ops-border-subtle));\n  background: var(--ops-header);\n  color: var(--ops-header-text);\n  font-family: Inter, \"SF Pro Text\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  font-feature-settings: \"cv01\" 1, \"ss03\" 1;\n}\n.zone-header::before {\n  content: \"\";\n  position: absolute;\n  top: 12px;\n  bottom: 12px;\n  left: 8px;\n  width: 4px;\n  border-radius: 999px;\n  background: var(--ops-brand);\n}\n.zone-title-block {\n  min-width: 0;\n  flex: 1 1 auto;\n}\n.zone-header.success {\n  border-top: 1px solid #cfe3d5;\n}\n.zone-header.warning {\n  border-top: 1px solid #e8d2aa;\n}\n.zone-title {\n  color: var(--ops-header-text);\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 0;\n  line-height: 1.35;\n}\n.zone-meta {\n  margin-top: 3px;\n  color: var(--ops-header-muted);\n  font-size: 12px;\n  font-weight: 500;\n  line-height: 1.35;\n}\n.zone-selection-toolbar {\n  margin-top: 10px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px 12px;\n}\n.zone-selection-summary, .zone-selection-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.zone-selection-pill {\n  display: inline-flex;\n  align-items: center;\n  flex: 0 0 auto;\n  height: 26px;\n  min-width: 60px;\n  padding: 0 9px;\n  border-color: var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border-radius: 6px;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  font-size: 12px;\n  font-weight: 650;\n  font-feature-settings: \"tnum\" 1;\n}\n.zone-selection-pill-context {\n  border-color: #d4dce8;\n  background: #f8fafc;\n  color: #536171;\n}\n.zone-selection-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n  flex: 0 0 auto;\n  min-width: 92px;\n  height: 34px;\n  min-height: 34px;\n  padding: 0 12px;\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border-color: var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border-radius: 6px;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  font-size: 12px;\n  font-weight: 650;\n  line-height: 1;\n  text-transform: none;\n  transform: none;\n  transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease, opacity 150ms ease;\n}\n.zone-selection-btn:hover:not(:disabled) {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-selection-btn.primary {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand);\n  color: #ffffff;\n  box-shadow: none;\n}\n.zone-selection-btn.primary:hover:not(:disabled) {\n  border-color: var(--ops-brand-dark);\n  background: var(--ops-brand-dark);\n  color: #ffffff;\n}\n.zone-selection-btn.warning {\n  border-color: #e8bd78;\n  background: #fff7e8;\n  color: #7a4d16;\n}\n.zone-selection-btn.warning:hover:not(:disabled) {\n  border-color: #d99a32;\n  background: #ffefd0;\n  color: #6b3f0f;\n}\n.zone-selection-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.48;\n  box-shadow: none;\n  transform: none;\n}\n.zone-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  align-items: flex-start;\n  gap: 10px;\n}\n.zone-aux-action-group {\n  display: inline-flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.zone-aux-action {\n  min-width: 84px;\n  border-color: #e8bd78;\n  background: #fff7e8;\n  color: #7a4d16;\n  flex: 0 0 auto;\n}\n.zone-aux-action:hover {\n  border-color: #d99a32;\n  background: #ffefd0;\n  color: #6b3f0f;\n}\n.zone-aux-action.danger {\n  border-color: #f4b4b4;\n  background: #fff1f1;\n  color: #8d2b2b;\n}\n.zone-aux-action.danger:hover {\n  border-color: #dc6f6f;\n  background: #ffe5e5;\n  color: #7a1f1f;\n}\n.zone-toggle-group {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 0;\n  border: 0;\n}\n.zone-toggle {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n  min-width: 92px;\n  height: 34px;\n  margin: 0;\n  padding: 0 14px;\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 24%, #d1d5db);\n  }\n  border-radius: 6px !important;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  font-size: 12px;\n  font-weight: 650;\n  line-height: 1;\n  cursor: pointer;\n  transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;\n}\n.zone-toggle + .zone-toggle {\n  margin-left: 0;\n}\n.zone-toggle.active {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand);\n  color: #ffffff;\n  box-shadow: none;\n}\n.zone-toggle:not(.active):hover:not(:disabled) {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-toggle:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n.zone-expand-icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 34px;\n  height: 34px;\n  padding: 0;\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 24%, #d1d5db);\n  }\n  border-radius: 6px;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  cursor: pointer;\n  flex: 0 0 auto;\n}\n.zone-expand-icon-btn:hover {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-expand-icon-btn.active {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-selection-btn:focus-visible, .zone-toggle:focus-visible, .zone-expand-icon-btn:focus-visible {\n  outline: 2px solid rgba(47, 128, 237, 0.42);\n  outline-offset: 2px;\n}\n.zone-expand-icon {\n  width: 16px;\n  height: 16px;\n  display: block;\n}\n.resizable-tri-pane {\n  --tri-pane-scrollbar-gutter: 15px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px;\n  height: 360px;\n  background: var(--ops-zone-body, #ffffff);\n  overflow: hidden;\n}\n.zone.zone-expanded .resizable-tri-pane {\n  height: min(72vh, 820px);\n  min-height: 540px;\n}\n.zone-hidden {\n  displ