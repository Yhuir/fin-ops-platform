ave-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 16px;\n  background: var(--fp-primary);\n  color: var(--fp-surface);\n  border: 1px solid var(--fp-primary);\n  border-radius: var(--fp-radius-sm);\n  font-size: 14px;\n  font-weight: 700;\n  cursor: pointer;\n}\n.settings-save-button:hover:not(:disabled) {\n  background: var(--fp-primary-hover);\n  border-color: var(--fp-primary-hover);\n}\n.settings-save-button:focus-visible {\n  outline: 2px solid var(--fp-primary);\n  outline-offset: 2px;\n}\n.settings-save-button:disabled {\n  background: var(--fp-surface-muted);\n  color: var(--fp-text-muted);\n  border-color: var(--fp-border);\n  cursor: not-allowed;\n}\n.settings-save-spinner {\n  width: 14px;\n  height: 14px;\n  border: 2px solid currentColor;\n  border-right-color: transparent;\n  border-radius: 999px;\n  animation: bank-auto-tag-spin 0.8s linear infinite;\n}\n.settings-primary-button, .settings-secondary-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 14px;\n  border-radius: var(--fp-radius-sm);\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1;\n  cursor: pointer;\n}\n.settings-primary-button {\n  background: var(--fp-primary);\n  color: var(--fp-surface);\n  border: 1px solid var(--fp-primary);\n}\n.settings-primary-button:hover:not(:disabled) {\n  background: var(--fp-primary-hover);\n  border-color: var(--fp-primary-hover);\n}\n.settings-secondary-button {\n  background: var(--fp-surface);\n  color: var(--fp-primary);\n  border: 1px solid var(--fp-border-strong);\n}\n.settings-secondary-button:hover:not(:disabled) {\n  background: var(--fp-surface-muted);\n  border-color: var(--fp-primary);\n}\n.settings-primary-button:disabled, .settings-secondary-button:disabled {\n  background: var(--fp-surface-muted);\n  color: var(--fp-text-muted);\n  border-color: var(--fp-border);\n  cursor: not-allowed;\n}\n.settings-field {\n  display: grid;\n  gap: 6px;\n  min-width: 160px;\n}\n.settings-field span {\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  font-weight: 700;\n}\n.settings-field small {\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  line-height: 1.4;\n}\n.settings-field--date {\n  max-width: 240px;\n}\n.settings-field--wide {\n  max-width: 420px;\n}\n.settings-field input, .settings-table-input, .settings-select-control {\n  width: 100%;\n  min-height: 36px;\n  padding: 6px 10px;\n  background: var(--fp-surface);\n  color: var(--fp-text-primary);\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  font-size: 14px;\n  font: inherit;\n}\n.settings-field input:focus, .settings-table-input:focus, .settings-select-control:focus {\n  border-color: var(--fp-primary);\n  outline: 2px solid var(--fp-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    outline: 2px solid color-mix(in srgb, var(--fp-primary) 20%, transparent);\n  }\n  outline-offset: 0;\n}\n.settings-field input:disabled, .settings-table-input:disabled, .settings-select-control:disabled {\n  background: var(--fp-surface-muted);\n  color: var(--fp-text-muted);\n  cursor: not-allowed;\n}\n.settings-project-toolbar, .settings-bank-mapping-form {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: end;\n  gap: 12px;\n}\n.settings-native-table-shell {\n  width: 100%;\n  overflow-x: auto;\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  background: var(--fp-surface);\n}\n.settings-native-table-shell--scroll {\n  max-height: 420px;\n  overflow: auto;\n}\n.settings-native-table {\n  width: 100%;\n  min-width: 560px;\n  border-collapse: collapse;\n  color: var(--fp-text-primary);\n  font-size: 13px;\n}\n.settings-native-table th, .settings-native-table td {\n  border-bottom: 1px solid var(--fp-border);\n  padding: 8px 10px;\n  text-align: left;\n  vertical-align: middle;\n}\n.settings-nati