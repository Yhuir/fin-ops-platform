ght: 78px;\n  resize: vertical;\n  padding: 9px 10px;\n  border: 1px solid #c9d6e5;\n  border-radius: 7px;\n  color: #172033;\n  background: #ffffff;\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.5;\n}\n.etc-dialog-field textarea:focus {\n  outline: none;\n  border-color: #2563eb;\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);\n}\n.etc-dialog-field textarea:disabled {\n  color: #94a3b8;\n  background: #f1f5f9;\n}\n.etc-supplement-upload-target {\n  display: grid;\n  gap: 5px;\n  padding: 10px;\n  border: 1px solid #dbe3ef;\n  border-radius: 8px;\n  background: #f9fbfe;\n}\n.etc-supplement-upload-target span {\n  color: #52677a;\n  font-size: 12px;\n  font-weight: 750;\n}\n.etc-supplement-upload-target strong {\n  color: #172033;\n  font-size: 13px;\n  font-weight: 850;\n}\n.etc-file-picker {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 36px;\n  width: fit-content;\n  max-width: 100%;\n  padding: 0 12px;\n  border: 1px solid #bfdbfe;\n  border-radius: 6px;\n  color: #1d4ed8;\n  background: #ffffff;\n  font-size: 13px;\n  font-weight: 800;\n  cursor: pointer;\n  overflow-wrap: anywhere;\n}\n.etc-file-picker:hover, .etc-file-picker:focus-within {\n  color: #1e40af;\n  background: #eff6ff;\n  border-color: #93c5fd;\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);\n}\n.etc-file-picker--disabled {\n  color: #94a3b8;\n  cursor: not-allowed;\n  background: #f1f5f9;\n  border-color: #e2e8f0;\n  box-shadow: none;\n}\n.etc-import-attempt-list {\n  display: grid;\n  gap: 8px;\n}\n.etc-import-attempt-row {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n  padding: 9px 10px;\n  border: 1px solid #dbe3ef;\n  border-radius: 8px;\n  background: #ffffff;\n}\n.etc-import-attempt-row strong, .etc-import-attempt-row span {\n  overflow-wrap: anywhere;\n}\n.etc-upload-blocks {\n  min-width: 0;\n}\n.etc-upload-drop-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n.etc-upload-drop-box {\n  display: flex;\n  gap: 10px;\n  min-width: 0;\n  min-height: 104px;\n  justify-content: flex-start;\n  align-items: flex-start;\n  padding: 12px;\n  border-color: #c9d6e5;\n  border-style: dashed;\n  border-width: 1px;\n  border-radius: 8px;\n  background: #f9fbfe;\n  color: #243b53;\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n  text-transform: none;\n  white-space: normal;\n}\n.etc-upload-drop-box:hover, .etc-upload-drop-box:focus-visible, .etc-upload-drop-box.dragging {\n  border-color: #2563eb;\n  background: #f5f9ff;\n  outline: none;\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);\n}\n.etc-upload-drop-box[aria-disabled=\"true\"] {\n  background: #f6f8fb;\n  border-color: #dbe3ef;\n  color: #64748b;\n  cursor: not-allowed;\n  box-shadow: none;\n}\n.etc-upload-drop-content {\n  display: grid;\n  gap: 5px;\n  min-width: 0;\n  width: 100%;\n  color: #52677a;\n  font-size: 12px;\n}\n.etc-upload-drop-content strong {\n  color: #172033;\n  font-size: 13px;\n}\n.etc-upload-drop-disabled-reason {\n  color: #b45309;\n  font-weight: 800;\n}\n@media (max-width: 900px) {\n  .etc-upload-drop-grid {\n    grid-template-columns: 1fr;\n  }\n}\n.etc-manual-review-panel {\n  display: grid;\n  gap: 12px;\n  padding: 12px;\n  border: 1px solid #dbe3ef;\n  border-radius: 8px;\n  background: #f9fbfe;\n}\n.etc-manual-review-grid {\n  display: grid;\n  grid-template-columns: minmax(180px, 1fr) minmax(180px, 1fr) minmax(220px, 1fr);\n  gap: 12px;\n  align-items: stretch;\n}\n.etc-manual-review-card {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n  padding: 10px;\n  border: 1px solid #dbe3ef;\n  border-radius: 8px;\n  background: #ffffff;\n}\n.etc-manual-review-card strong {\n  color: #172033;\n  font-size: 13px;\n}\n.etc-manual-review-card span:last-child {\n  color: #52677a;\n  font-size: 12px;\n  line-height: 1.45;\n}\n.etc-manual-review-label, .etc-manual-review-field > span {\n  color: #52677a;\n  font-size: 12px;\n  font-weight: 800;\n}\n.etc