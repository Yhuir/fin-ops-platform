0;\n}\n.workbench-settings-modal {\n  width: min(1080px, calc(100vw - 40px));\n}\n.settings-page-shell {\n  padding: 18px;\n  background: linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);\n}\n.settings-page-panel {\n  display: grid;\n  grid-template-rows: auto 1fr auto;\n  border-radius: 8px;\n  background: #ffffff;\n  overflow: hidden;\n}\n.settings-page-header, .settings-page-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 22px 24px;\n  border-bottom: 1px solid #eef3f8;\n}\n.settings-page-header h2 {\n  margin: 0;\n  color: #102a43;\n  font-size: 24px;\n}\n.settings-page-header p {\n  margin: 8px 0 0;\n  color: #486581;\n  font-size: 13px;\n  line-height: 1.6;\n}\n.settings-page-body {\n  overflow: auto;\n  padding: 20px 24px 24px;\n  display: grid;\n  gap: 18px;\n  background: linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);\n}\n.settings-page-footer {\n  border-top: 1px solid #eef3f8;\n  border-bottom: 0;\n}\n.settings-session-account {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n  margin-top: 10px;\n  color: #243b53;\n  font-size: 13px;\n}\n.settings-session-account-label {\n  color: #486581;\n  font-weight: 700;\n}\n.settings-session-account strong {\n  color: #102a43;\n  font-weight: 800;\n}\n.workbench-settings-body {\n  align-items: start;\n}\n.settings-route {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  height: 100%;\n  min-height: 0;\n  background: var(--fp-surface);\n}\n.settings-route-status {\n  display: grid;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n.settings-state-banner {\n  grid-column: 1 / -1;\n}\n.settings-layout {\n  display: grid;\n  flex: 1;\n  grid-template-columns: minmax(0, 1fr);\n  min-height: 0;\n  background: var(--fp-surface);\n}\n.settings-nav-shell {\n  min-width: 0;\n  padding: 12px;\n  background: var(--fp-surface-muted);\n  border-bottom: 1px solid var(--fp-border);\n}\n.settings-two-column-layout {\n  display: grid;\n  grid-template-columns: minmax(240px, 0.92fr) minmax(0, 1.58fr);\n  gap: 14px;\n  min-height: 520px;\n}\n.settings-tree-nav {\n  width: 100%;\n}\n.settings-tree-nav__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 12px;\n  padding: 0 4px;\n}\n.settings-tree-nav__header h2 {\n  margin: 0;\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.35;\n  text-transform: uppercase;\n}\n.settings-tree-nav__header span {\n  color: var(--fp-text-muted);\n  font-size: 12px;\n  font-weight: 700;\n}\n.settings-tree-panel {\n  display: grid;\n  align-self: start;\n  gap: 0;\n  border-radius: 8px;\n  overflow: hidden;\n}\n.settings-tree {\n  display: grid;\n  gap: 0;\n  margin: 0;\n  padding: 0;\n  width: 100%;\n  list-style: none;\n}\n.settings-tree-item {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  width: 100%;\n  min-height: 56px;\n  padding: 8px 8px 8px 16px;\n  background: transparent;\n  border: 0;\n  border-left: 2px solid var(--fp-border);\n  color: var(--fp-text-primary);\n  cursor: pointer;\n  text-align: left;\n}\n.settings-tree-item:hover {\n  background: var(--fp-surface-muted);\n}\n.settings-tree-item:focus-visible {\n  outline: 2px solid var(--fp-primary);\n  outline-offset: -2px;\n}\n.settings-tree-item[aria-selected=\"true\"], .settings-tree-item--selected {\n  background: var(--fp-primary-soft);\n  border-left-color: var(--fp-primary);\n}\n.settings-tree-dot {\n  display: none;\n}\n.settings-tree-copy {\n  display: grid;\n  gap: 6px;\n  min-width: 0;\n}\n.settings-tree-copy strong {\n  color: var(--fp-text-primary);\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.55;\n  overflow-wrap: anywhere;\n}\n.settings-tree-copy small {\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  line-height: 1.55;\n}\n.settings-tree-count {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\