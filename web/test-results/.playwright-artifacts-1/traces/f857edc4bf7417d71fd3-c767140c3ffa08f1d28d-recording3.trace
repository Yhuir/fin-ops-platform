e-flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  max-width: 100%;\n}\n.tax-invoice-meta-row {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  max-width: 100%;\n  flex-wrap: nowrap;\n  white-space: nowrap;\n}\n.tax-invoice-number {\n  display: block;\n  max-width: 100%;\n  line-height: 1.22;\n  text-align: center;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n.tax-check-column {\n  width: 60px;\n  min-width: 60px;\n  text-align: center;\n}\n.tax-column-invoice-no {\n  width: 160px;\n  min-width: 160px;\n}\n.tax-column-tax-amount, .tax-column-amount {\n  width: 92px;\n  min-width: 92px;\n  white-space: nowrap;\n}\n.tax-column-amount-rate {\n  width: 112px;\n  min-width: 112px;\n  white-space: nowrap;\n}\n.tax-column-counterparty {\n  min-width: 132px;\n  max-width: 152px;\n  white-space: normal;\n  text-align: center;\n  line-height: 1.2;\n  overflow-wrap: anywhere;\n}\n.tax-column-header-with-filter {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n.tax-grid-table input[type=\"checkbox\"] {\n  width: 16px;\n  height: 16px;\n  accent-color: #0f4c81;\n  cursor: pointer;\n}\n.tax-grid-table td {\n  text-align: center;\n  vertical-align: middle;\n}\n.tax-amount-rate-value {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  width: 100%;\n}\n.tax-amount-rate-primary {\n  display: block;\n}\n.tax-row-selected {\n  background: #f4f9ff;\n}\n.tax-row-locked {\n  background: #f8fafc;\n  color: #7b8794;\n}\n.tax-row-highlighted {\n  outline: 2px solid #164c9b;\n  outline-offset: -2px;\n  background: #eef6ff;\n}\n.tax-status-tag {\n  display: inline-flex;\n  align-items: center;\n  min-height: 18px;\n  padding: 0 7px;\n  border-radius: 999px;\n  font-size: 10px;\n  font-weight: 800;\n  line-height: 1;\n  white-space: nowrap;\n}\n.tax-status-tag-certified {\n  background: #eefaf2;\n  color: #1f7a3f;\n}\n.tax-sta