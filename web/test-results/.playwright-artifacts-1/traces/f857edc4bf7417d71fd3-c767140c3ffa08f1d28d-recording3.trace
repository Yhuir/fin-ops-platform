7d4a6;\n  background: #fffaf2;\n}\n.import-file-meta {\n  justify-content: flex-start;\n  gap: 10px;\n}\n.status-chip {\n  display: inline-flex;\n  align-items: center;\n  padding: 6px 12px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 800;\n}\n.status-chip.tone-success {\n  background: rgba(20, 184, 166, 0.12);\n  color: #0f766e;\n}\n.status-chip.tone-warn {\n  background: rgba(245, 158, 11, 0.16);\n  color: #b45309;\n}\n.status-chip.tone-neutral {\n  background: rgba(148, 163, 184, 0.14);\n  color: #475569;\n}\n.import-result-panel {\n  padding: 18px;\n  border-radius: 8px;\n  background: #f9fbfe;\n}\n.import-override-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 12px;\n}\n.import-select-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  color: #334e68;\n  font-size: 12px;\n  font-weight: 700;\n}\n.import-select-field select {\n  min-height: 42px;\n  border: 1px solid #d8e1eb;\n  border-radius: 8px;\n  background: #fff;\n  color: #102a43;\n  font-size: 13px;\n  padding: 0 12px;\n}\n.cost-page {\n  gap: var(--fp-space-3);\n}\n.cost-header-actions {\n  align-items: flex-end;\n}\n.cost-page .stats-row {\n  gap: var(--fp-space-2);\n}\n.cost-page .stat-card {\n  padding: var(--fp-space-3);\n  border-color: var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  background: var(--fp-surface);\n  box-shadow: none;\n  transition: border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);\n}\n.cost-page .stat-card:hover {\n  border-color: var(--fp-border-strong);\n  background: var(--fp-surface-raised);\n}\n.cost-page .stat-card span {\n  color: var(--fp-text-muted);\n  font-size: var(--fp-text-caption);\n  font-weight: 700;\n}\n.cost-page .stat-card strong {\n  margin-top: var(--fp-space-1);\n  color: var(--fp-text);\n  font-family: var(--fp-font-data);\n  font-size: 20px;\n  font-variant-numeric: tabular-nums;\n  letter-spacing: 0;\n}\n.workbench-settings-modal {\n  width: min(1080px, calc(100vw - 40px));\n}\n.settings-page-shell {\n  padding: 18px;\n  background: linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);\n}\n.settings-page-panel {\n  display: grid;\n  grid-template-rows: auto 1fr auto;\n  border-radius: 8px;\n  background: #ffffff;\n  overflow: hidden;\n}\n.settings-page-header, .settings-page-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 22px 24px;\n  border-bottom: 1px solid #eef3f8;\n}\n.settings-page-header h2 {\n  margin: 0;\n  color: #102a43;\n  font-size: 24px;\n}\n.settings-page-header p {\n  margin: 8px 0 0;\n  color: #486581;\n  font-size: 13px;\n  line-height: 1.6;\n}\n.settings-page-body {\n  overflow: auto;\n  padding: 20px 24px 24px;\n  display: grid;\n  gap: 18px;\n  background: linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);\n}\n.settings-page-footer {\n  border-top: 1px solid #eef3f8;\n  border-bottom: 0;\n}\n.settings-session-account {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n  margin-top: 10px;\n  color: #243b53;\n  font-size: 13px;\n}\n.settings-session-account-label {\n  color: #486581;\n  font-weight: 700;\n}\n.settings-session-account strong {\n  color: #102a43;\n  font-weight: 800;\n}\n.workbench-settings-body {\n  align-items: start;\n}\n.settings-route {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  height: 100%;\n  min-height: 0;\n  background: var(--fp-surface);\n}\n.settings-route-status {\n  display: grid;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n.settings-state-banner {\n  grid-column: 1 / -1;\n}\n.settings-layout {\n  display: grid;\n  flex: 1;\n  grid-template-columns: minmax(0, 1fr);\n  min-height: 0;\n  background: var(--fp-surface);\n}\n.settings-nav-shell {\n  min-width: 0;\n  padding: 12px;\n  background: var(--fp-surface-muted);\n  border-bottom: 1px solid var(--fp-border);\n}\n.settings-two-column-layout {\n  display: grid;\n  grid-template-columns: minmax(240px, 0.92fr) minmax(0, 1.58fr);\n  gap: 14px;\n  min-height: 520px;\n}\n.settings-tree-nav {\n  width: 100%;\n}\n.settings-tree-nav__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 12px;\n  padding: 0 4px;\n}\n.settings-tree-nav__header h2 {\n  margin: 0;\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.35;\n  text-transform: uppercase;\n}\n.settings-tree-nav__header span {\n  color: var(--fp-text-muted);\n  font-size: 12px;\n  font-weight: 700;\n}\n.settings-tree-panel {\n  display: grid;\n  align-self: start;\n  gap: 0;\n  border-radius: 8px;\n  overflow: hidden;\n}\n.settings-tree {\n  display: grid;\n  gap: 0;\n  margin: 0;\n  padding: 0;\n  width: 100%;\n  list-style: none;\n}\n.settings-tree-item {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  width: 100%;\n  min-height: 56px;\n  padding: 8px 8px 8px 16px;\n  background: transparent;\n  border: 0;\n  border-left: 2px solid var(--fp-border);\n  color: var(--fp-text-primary);\n  cursor: pointer;\n  text-align: left;\n}\n.settings-tree-item:hover {\n  background: var(--fp-surface-muted);\n}\n.settings-tree-item:focus-visible {\n  outline: 2px solid var(--fp-primary);\n  outline-offset: -2px;\n}\n.settings-tree-item[aria-selected=\"true\"], .settings-tree-item--selected {\n  background: var(--fp-primary-soft);\n  border-left-color: var(--fp-primary);\n}\n.settings-tree-dot {\n  display: none;\n}\n.settings-tree-copy {\n  display: grid;\n  gap: 6px;\n  min-width: 0;\n}\n.settings-tree-copy strong {\n  color: var(--fp-text-primary);\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.55;\n  overflow-wrap: anywhere;\n}\n.settings-tree-copy small {\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  line-height: 1.55;\n}\n.settings-tree-count {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  padding: 0;\n  background: none;\n  color: var(--fp-primary);\n  font-size: 12px;\n  font-weight: 700;\n  white-space: nowrap;\n}\n.settings-content-panel, .settings-section-panel {\n  min-width: 0;\n}\n.settings-content-panel {\n  min-height: 0;\n  overflow: auto;\n  padding: 16px;\n  background: var(--fp-surface);\n}\n.settings-content-header {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  margin-bottom: 24px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--fp-border);\n}\n.settings-content-title {\n  min-width: 0;\n}\n.settings-content-title h1 {\n  margin: 0;\n  color: var(--fp-text-primary);\n  font-size: 20px;\n  font-weight: 600;\n  line-height: 1.35;\n}\n.settings-content-title p {\n  max-width: 720px;\n  margin: 6px 0 0;\n  color: var(--fp-text-secondary);\n  font-size: 14px;\n  line-height: 1.55;\n}\n.settings-inline-alert {\n  margin-top: 12px;\n  padding: 8px 12px;\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  font-size: 13px;\n  line-height: 1.45;\n}\n.settings-inline-alert strong {\n  display: block;\n  margin-bottom: 4px;\n  font-weight: 700;\n}\n.settings-inline-alert p {\n  margin: 0;\n}\n.settings-inline-alert--warning {\n  color: var(--fp-warning);\n  background: var(--fp-warning-soft);\n  border-color: var(--fp-warning);\n}\n.settings-inline-alert--info {\n  color: var(--fp-info);\n  background: var(--fp-primary-soft);\n  border-color: var(--fp-info);\n}\n.settings-inline-alert--success {\n  color: var(--fp-success);\n  background: var(--fp-success-soft);\n  border-color: var(--fp-success);\n}\n.settings-inline-alert--error {\n  color: var(--fp-danger);\n  background: var(--fp-danger-soft);\n  border-color: var(--fp-danger);\n}\n.settings-save-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  flex-shrink: 0;\n}\n.settings-save-actions > span {\n  color: var(--fp-text-muted);\n  font-size: 12px;\n}\n.settings-save-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 16px;\n  background: var(--fp-primary);\n  color: var(--fp-surface);\n  border: 1px solid var(--fp-primary);\n  border-radius: var(--fp-radius-sm);\n  font-size: 14px;\n  font-weight: 700;\n  cursor: pointer;\n}\n.settings-save-button:hover:not(:disabled) {\n  background: var(--fp-primary-hover);\n  border-color: var(--fp-primary-hover);\n}\n.settings-save-button:focus-visible {\n  outline: 2px solid var(--fp-primary);\n  outline-offset: 2px;\n}\n.settings-save-button:disabled {\n  background: var(--fp-surface-muted);\n  color: var(--fp-text-muted);\n  border-color: var(--fp-border);\n  cursor: not-allowed;\n}\n.settings-save-spinner {\n  width: 14px;\n  height: 14px;\n  border: 2px solid currentColor;\n  border-right-color: transparent;\n  border-radius: 999px;\n  animation: bank-auto-tag-spin 0.8s linear infinite;\n}\n.settings-primary-button, .settings-secondary-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 14px;\n  border-radius: var(--fp-radius-sm);\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1;\n  cursor: pointer;\n}\n.settings-primary-button {\n  background: var(--fp-primary);\n  color: var(--fp-surface);\n  border: 1px solid var(--fp-primary);\n}\n.settings-primary-button:hover:not(:disabled) {\n  background: var(--fp-primary-hover);\n  border-color: var(--fp-primary-hover);\n}\n.settings-secondary-button {\n  background: var(--fp-surface);\n  color: var(--fp-primary);\n  border: 1px solid var(--fp-border-strong);\n}\n.settings-secondary-button:hover:not(:disabled) {\n  background: var(--fp-surface-muted);\n  border-color: var(--fp-primary);\n}\n.settings-primary-button:disabled, .settings-secondary-button:disabled {\n  background: var(--fp-surface-muted);\n  color: var(--fp-text-muted);\n  border-color: var(--fp-border);\n  cursor: not-allowed;\n}\n.settings-field {\n  display: grid;\n  gap: 6px;\n  min-width: 160px;\n}\n.settings-field span {\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  font-weight: 700;\n}\n.settings-field small {\n  color: var(--fp-text-secondary);\n  font-size: 12px;\n  line-height: 1.4;\n}\n.settings-field--date {\n  max-width: 240px;\n}\n.settings-field--wide {\n  max-width: 420px;\n}\n.settings-field input, .settings-table-input, .settings-select-control {\n  width: 100%;\n  min-height: 36px;\n  padding: 6px 10px;\n  background: var(--fp-surface);\n  color: var(--fp-text-primary);\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  font-size: 14px;\n  font: inherit;\n}\n.settings-field input:focus, .settings-table-input:focus, .settings-select-control:focus {\n  border-color: var(--fp-primary);\n  outline: 2px solid var(--fp-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    outline: 2px solid color-mix(in srgb, var(--fp-primary) 20%, transparent);\n  }\n  outline-offset: 0;\n}\n.settings-field input:disabled, .settings-table-input:disabled, .settings-select-control:disabled {\n  background: var(--fp-surface-muted);\n  color: var(--fp-text-muted);\n  cursor: not-allowed;\n}\n.settings-project-toolbar, .settings-bank-mapping-form {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: end;\n  gap: 12px;\n}\n.settings-native-table-shell {\n  width: 100%;\n  overflow-x: auto;\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  background: var(--fp-surface);\n}\n.settings-native-table-shell--scroll {\n  max-height: 420px;\n  overflow: auto;\n}\n.settings-native-table {\n  width: 100%;\n  min-width: 560px;\n  border-collapse: collapse;\n  color: var(--fp-text-primary);\n  font-size: 13px;\n}\n.settings-native-table th, .settings-native-table td {\n  border-bottom: 1px solid var(--fp-border);\n  padding: 8px 10px;\n  text-align: left;\n  vertical-align: middle;\n}\n.settings-native