 word-break: break-word;\n}\n.certified-import-file-item span {\n  color: #61758a;\n  font-size: 12px;\n  white-space: nowrap;\n}\n.certified-import-summary {\n  gap: 10px;\n}\n.certified-import-preview-files {\n  display: grid;\n  gap: 10px;\n}\n.tax-page-actions .page-note {\n  min-height: 34px;\n  border-radius: var(--fp-radius-sm);\n  padding-block: 6px;\n  font-size: var(--fp-text-label);\n}\n.tax-summary-strip {\n  grid-template-columns: repeat(5, minmax(136px, 1fr));\n  gap: var(--fp-space-2);\n}\n.tax-summary-card.stat-card {\n  min-height: 68px;\n  padding: 10px 12px;\n  border-color: var(--fp-border);\n  border-radius: var(--fp-radius-md);\n  background: var(--fp-surface);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);\n  transition: border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);\n}\n.tax-summary-card.stat-card:hover {\n  border-color: var(--fp-border-strong);\n  background: var(--fp-surface-raised);\n}\n.tax-summary-card.stat-card span {\n  color: var(--fp-text-muted);\n  font-size: var(--fp-text-label);\n  font-weight: 700;\n}\n.tax-summary-card.stat-card strong {\n  margin-top: 6px;\n  color: var(--fp-ink);\n  font-family: var(--fp-font-data);\n  font-size: 20px;\n  font-variant-numeric: tabular-nums;\n  line-height: 1.2;\n}\n.tax-summary-card.stat-card.warn {\n  border-color: var(--fp-warning);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--fp-warning) 26%, var(--fp-border));\n  }\n  background: linear-gradient(180deg, var(--fp-surface), var(--fp-warning-soft));\n}\n.tax-summary-card.stat-card.success {\n  border-color: var(--fp-success);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--fp-success) 26%, var(--fp-border));\n  }\n  background: linear-gradient(180deg, var(--fp-surface), var(--fp-success-soft));\n}\n.tax-offset-workspace 