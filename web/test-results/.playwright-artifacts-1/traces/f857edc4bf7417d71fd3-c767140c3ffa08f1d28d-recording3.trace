#c9def5;\n  border-radius: 14px;\n  background: #edf5ff;\n  color: #164c9b;\n  font-size: 12px;\n  font-weight: 700;\n}\n.action-feedback.success {\n  border-color: #b9e1c8;\n  background: #eef9f1;\n  color: #206a46;\n}\n.action-feedback.error {\n  border-color: #f0c6c6;\n  background: #fff3f3;\n  color: #b42318;\n}\n.state-panel, .detail-state-panel {\n  padding: 12px 14px;\n  border: 1px solid #d8e1eb;\n  border-radius: 14px;\n  background: #f8fbff;\n  color: #486581;\n  font-size: 12px;\n  font-weight: 700;\n}\n.state-panel.error, .detail-state-panel.error {\n  border-color: #f0c6c6;\n  background: #fff3f3;\n  color: #b42318;\n}\n.stats-row {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 12px;\n}\n.stat-card {\n  padding: 14px 16px;\n  border: 1px solid #d8e1eb;\n  border-radius: 16px;\n  background: #fbfdff;\n}\n.stat-card span {\n  display: block;\n  font-size: 12px;\n  color: #5d6d7e;\n}\n.stat-card strong {\n  display: block;\n  margin-top: 8px;\n  font-size: 22px;\n}\n.stat-card.warn {\n  background: #fff8e5;\n}\n.stat-card.success {\n  background: #ebf8f0;\n}\n.zone {\n  --ops-surface: #ffffff;\n  --ops-page: #f8fafc;\n  --ops-panel: #f5f7fa;\n  --ops-text: #1f2937;\n  --ops-muted: #64748b;\n  --ops-ink: #111827;\n  --ops-border: #d7e0ea;\n  --ops-border-subtle: rgba(15, 23, 42, 0.1);\n  --ops-header: #f8fafc;\n  --ops-header-raised: #ffffff;\n  --ops-header-text: #1f2937;\n  --ops-header-muted: #64748b;\n  --ops-brand: #3b82f6;\n  --ops-brand-dark: #2563eb;\n  --ops-brand-soft: #eaf3ff;\n  --ops-grid-header: #1e293b;\n  --ops-grid-header-hover: #334155;\n  --ops-grid-header-border: rgba(148, 163, 184, 0.42);\n  --ops-grid-header-icon: #cbd5e1;\n  --ops-grid-header-active: #60a5fa;\n  --ops-success: #27a644;\n  --ops-warning: #d89b2b;\n  border: 1px solid var(--ops-border);\n  border-radius: 8px;\n  overflow: hidden;\n  background: var(--ops-surface);\n  box-shadow: rgba(15, 39, 66, 0.13) 0 10px 26px -18px, rgba(0, 0, 0, 0.08) 0 4px 12px -10px;\n}\n.zone-success {\n  --ops-header: #f4faf7;\n  --ops-header-raised: #ffffff;\n  --ops-header-text: #1f3a29;\n  --ops-header-muted: #496b55;\n  --ops-brand: #2f6b3f;\n  --ops-brand-dark: #255532;\n  --ops-brand-soft: rgba(47, 107, 63, 0.1);\n  --ops-header-border: #cfe3d5;\n  --ops-zone-body: #f3f4f6;\n  --ops-row-band-a: #fff8e6;\n  --ops-row-band-b: #e7f3ff;\n  --ops-row-border-a: #ead7aa;\n  --ops-row-border-b: #b9d4ed;\n  --ops-row-divider-a: #ead7aa;\n  --ops-row-divider-b: #b9d4ed;\n  border-color: #d1d5db;\n  background: #f3f4f6;\n}\n.zone-warning {\n  --ops-header: #fff7e8;\n  --ops-header-raised: #ffffff;\n  --ops-header-text: #513a1f;\n  --ops-header-muted: #76582f;\n  --ops-brand: #b8752b;\n  --ops-brand-dark: #95591d;\n  --ops-brand-soft: rgba(184, 117, 43, 0.12);\n  --ops-header-border: #e8d2aa;\n  --ops-zone-body: #f3f4f6;\n  --ops-row-band-a: #fff8e6;\n  --ops-row-band-b: #e7f3ff;\n  --ops-row-border-a: #ead7aa;\n  --ops-row-border-b: #b9d4ed;\n  --ops-row-divider-a: #ead7aa;\n  --ops-row-divider-b: #b9d4ed;\n  border-color: #d1d5db;\n  background: #f3f4f6;\n}\n.zone-header {\n  position: relative;\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 12px 16px 12px 18px;\n  align-items: flex-start;\n  border-bottom: 1px solid var(--ops-header-border, var(--ops-border-subtle));\n  background: var(--ops-header);\n  color: var(--ops-header-text);\n  font-family: Inter, \"SF Pro Text\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  font-feature-settings: \"cv01\" 1, \"ss03\" 1;\n}\n.zone-header::before {\n  content: \"\";\n  position: absolute;\n  top: 12px;\n  bottom: 12px;\n  left: 8px;\n  width: 4px;\n  border-radius: 999px;\n  background: var(--ops-brand);\n}\n.zone-title-block {\n  min-width: 0;\n  flex: 1 1 auto;\n}\n.zone-header.success {\n  border-top: 1px solid #cfe3d5;\n}\n.zone-header.warning {\n  border-top: 1px solid #e8d2aa;\n}\n.zone-title {\n  color: var(--ops-header-text);\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 0;\n  line-height: 1.35;\n}\n.zone-meta {\n  margin-top: 3px;\n  color: var(--ops-header-muted);\n  font-size: 12px;\n  font-weight: 500;\n  line-height: 1.35;\n}\n.zone-selection-toolbar {\n  margin-top: 10px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px 12px;\n}\n.zone-selection-summary, .zone-selection-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.zone-selection-pill {\n  display: inline-flex;\n  align-items: center;\n  flex: 0 0 auto;\n  height: 26px;\n  min-width: 60px;\n  padding: 0 9px;\n  border-color: var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border-radius: 6px;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  font-size: 12px;\n  font-weight: 650;\n  font-feature-settings: \"tnum\" 1;\n}\n.zone-selection-pill-context {\n  border-color: #d4dce8;\n  background: #f8fafc;\n  color: #536171;\n}\n.zone-selection-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n  flex: 0 0 auto;\n  min-width: 92px;\n  height: 34px;\n  min-height: 34px;\n  padding: 0 12px;\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border-color: var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: color-mix(in srgb, var(--ops-brand) 28%, #d1d5db);\n  }\n  border-radius: 6px;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  font-size: 12px;\n  font-weight: 650;\n  line-height: 1;\n  text-transform: none;\n  transform: none;\n  transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease, opacity 150ms ease;\n}\n.zone-selection-btn:hover:not(:disabled) {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-selection-btn.primary {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand);\n  color: #ffffff;\n  box-shadow: none;\n}\n.zone-selection-btn.primary:hover:not(:disabled) {\n  border-color: var(--ops-brand-dark);\n  background: var(--ops-brand-dark);\n  color: #ffffff;\n}\n.zone-selection-btn.warning {\n  border-color: #e8bd78;\n  background: #fff7e8;\n  color: #7a4d16;\n}\n.zone-selection-btn.warning:hover:not(:disabled) {\n  border-color: #d99a32;\n  background: #ffefd0;\n  color: #6b3f0f;\n}\n.zone-selection-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.48;\n  box-shadow: none;\n  transform: none;\n}\n.zone-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  align-items: flex-start;\n  gap: 10px;\n}\n.zone-aux-action-group {\n  display: inline-flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.zone-aux-action {\n  min-width: 84px;\n  border-color: #e8bd78;\n  background: #fff7e8;\n  color: #7a4d16;\n  flex: 0 0 auto;\n}\n.zone-aux-action:hover {\n  border-color: #d99a32;\n  background: #ffefd0;\n  color: #6b3f0f;\n}\n.zone-aux-action.danger {\n  border-color: #f4b4b4;\n  background: #fff1f1;\n  color: #8d2b2b;\n}\n.zone-aux-action.danger:hover {\n  border-color: #dc6f6f;\n  background: #ffe5e5;\n  color: #7a1f1f;\n}\n.zone-toggle-group {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 0;\n  border: 0;\n}\n.zone-toggle {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n  min-width: 92px;\n  height: 34px;\n  margin: 0;\n  padding: 0 14px;\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 24%, #d1d5db);\n  }\n  border-radius: 6px !important;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  font-size: 12px;\n  font-weight: 650;\n  line-height: 1;\n  cursor: pointer;\n  transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;\n}\n.zone-toggle + .zone-toggle {\n  margin-left: 0;\n}\n.zone-toggle.active {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand);\n  color: #ffffff;\n  box-shadow: none;\n}\n.zone-toggle:not(.active):hover:not(:disabled) {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-toggle:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n.zone-expand-icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 34px;\n  height: 34px;\n  padding: 0;\n  border: 1px solid var(--ops-brand);\n  @supports (color: color-mix(in lab, red, red)) {\n    border: 1px solid color-mix(in srgb, var(--ops-brand) 24%, #d1d5db);\n  }\n  border-radius: 6px;\n  background: #ffffff;\n  color: var(--ops-header-text);\n  cursor: pointer;\n  flex: 0 0 auto;\n}\n.zone-expand-icon-btn:hover {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-expand-icon-btn.active {\n  border-color: var(--ops-brand);\n  background: var(--ops-brand-soft);\n  color: var(--ops-brand-dark);\n}\n.zone-selection-btn:focus-visible, .zone-toggle:focus-visible, .zone-expand-icon-btn:focus-visible {\n  outline: 2px solid rgba(47, 128, 237, 0.42);\n  outline-offset: 2px;\n}\n.zone-expand-icon {\n  width: 16px;\n  height: 16px;\n  display: block;\n}\n.resizable-tri-pane {\n  --tri-pane-scrollbar-gutter: 15px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px;\n  height: 360px;\n  background: var(--ops-zone-body, #ffffff);\n  overflow: hidden;\n}\n.zone.zone-expanded .resizable-tri-pane {\n  height: min(72vh, 820px);\n  min-height: 540px;\n}\n.zone-hidden {\n  display: none;\n}\n.candidate-grid-splitters {\n  display: grid;\n  gap: 0;\n  align-items: stretch;\n  padding-right: var(--tri-pane-scrollbar-gutter);\n}\n.pane-header-slot {\n  min-height: 1px;\n}\n.pane-header-slot-hidden {\n  overflow: hidden;\n}\n.candidate-grid {\n  display: flex;\n  flex: 1;\n  min-height: 0;\n  flex-direction: column;\n  gap: 4px;\n  background: var(--ops-zone-body, #f8fafc);\n}\n.candidate-grid-head {\n  display: grid;\n  gap: 0;\n  position: relative;\n  z-index: 3;\n  padding-right: var(--tri-pane-scrollbar-gutter);\n}\n.candidate-pane-head {\n  min-width: 0;\n  height: 112px;\n  min-height: 112px;\n  overflow: hidden;\n}\n.candidate-pane-head.pane-card {\n  overflow: hidden;\n  position: relative;\n  z-index: 6;\n  border-color: #cfd9e5;\n  border-radius: 0;\n  background: #ffffff;\n  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);\n}\n.candidate-pane-hidden {\n  display: none;\n  pointer-events: none;\n  overflow: hidden;\n}\n.candidate-pane-scroll {\n  overflow-x: hidden;\n  overflow-y: hidden;\n  flex: 0 0 56px;\n  min-height: 56px;\n  scrollbar-width: none;\n  position: relative;\n  z-index: 2;\n}\n.candidate-pane-scroll::-webkit-scrollbar {\n  display: none;\n}\n.candidate-pane-columnheaders {\n  display: grid;\n  align-items: stretch;\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\n  position: relative;\n  z-index: 1;\n  background: var(--ops-grid-header);\n}\n.candidate-pane-columnheaders-oa.pane-layout-no-action, .record-card-oa.record-card-no-action {\n  grid-template-columns: 88px minmax(192px, 1.4fr) 92px minmax(160px, 1.08fr) minmax(168px, 1.1fr);\n  min-width: 608px;\n}\n.candidate-pane-columnheaders-oa.pane-layout-with-action, .record-card-oa.record-card-has-action {\n  grid-template-columns: 88px minmax(192px, 1.32fr) 92px minmax(160px, 1.08fr) minmax(168px, 1.08fr) 168px;\n  min-width: 776px;\n}\n.candidate-pane-columnheaders-bank.pane-layout-no-action, .record-card-bank.record-card-no-action {\n  grid-template-columns: minma