;\n  text-overflow: ellipsis;\n  white-space: normal;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n}\n.bank-counterparty-name.regular {\n  font-size: 14px;\n}\n.bank-counterparty-name.compact {\n  font-size: 12.5px;\n}\n.bank-counterparty-name.dense {\n  font-size: 11px;\n  line-height: 1.1;\n}\n.bank-table-text-cell {\n  display: block;\n  overflow-wrap: anywhere;\n  color: #3f4652;\n  line-height: 1.25;\n  white-space: normal;\n}\n.bank-transaction-grid .bank-grid-row-even {\n  background: #ffffff;\n}\n.bank-transaction-grid .bank-grid-row-odd {\n  background: #fbfcfd;\n}\n.bank-transaction-grid .bank-grid-row-even:hover, .bank-transaction-grid .bank-grid-row-odd:hover {\n  background: #f3f7ff;\n}\n.bank-col-counterparty {\n  width: 25%;\n}\n.bank-col-type {\n  width: 72px;\n}\n.bank-col-amount {\n  width: 132px;\n}\n.bank-col-balance {\n  width: 104px;\n}\n.bank-col-purpose {\n  width: 13%;\n  vertical-align: top;\n}\n.bank-col-summary {\n  width: 13%;\n  vertical-align: top;\n}\n.bank-col-note {\n  width: 13%;\n  vertical-align: top;\n}\n.bank-auto-type-empty {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 24px;\n  color: var(--bank-text-secondary);\n  font-size: 12px;\n  font-weight: 700;\n}\n.bank-manual-category-stack {\n  display: inline-grid;\n  gap: 4px;\n  justify-items: center;\n  min-width: 0;\n}\n.bank-manual-category-revoke {\n  min-height: 24px;\n  border: 0;\n  border-radius: 4px;\n  background: transparent;\n  color: #0f62fe;\n  cursor: pointer;\n  font: inherit;\n  font-size: 12px;\n  font-weight: 800;\n  padding: 2px 8px;\n}\n.bank-manual-category-revoke:hover, .bank-manual-category-revoke:focus-visible {\n  background: #edf5ff;\n  outline: none;\n}\n.bank-manual-category-revoke:disabled {\n  color: #94a3b8;\n  cursor: not-allowed;\n}\n.bank-details-page .direction-tag {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 auto;\n  min-width: 34px;\n 