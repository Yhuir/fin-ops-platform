nk-relation-tag .bank-chip-label {\n  min-width: 0;\n  max-width: 100%;\n  padding-inline: 7px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.bank-details-page .bank-relation-tag-has {\n  background: #eef7f1;\n  color: #245c32;\n}\n.bank-details-page .bank-relation-tag-candidate {\n  background: #fff4dc;\n  color: #7a4b00;\n}\n.bank-details-page .bank-relation-tag-none {\n  background: #fbf1e5;\n  color: #6b4618;\n}\n.bank-details-page .bank-source-chip .bank-chip-label, .bank-details-page .direction-tag .bank-chip-label {\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.bank-details-page .bank-source-chip {\n  display: inline-flex;\n  align-items: center;\n  align-self: center;\n  flex: 0 1 auto;\n  min-width: 0;\n  max-width: 100%;\n  min-height: 22px;\n  height: auto;\n  border-color: var(--bank-border-subtle);\n  color: var(--bank-text-secondary);\n  font-size: 10.5px;\n}\n.bank-details-page .direction-tag.expense, .bank-details-page .direction-tag.outflow {\n  background: #fbeceb;\n  color: #8a1f18;\n}\n.bank-category-picker-trigger {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 4px;\n  width: 100%;\n  min-width: 0;\n  min-height: 40px;\n  padding: 4px 6px 4px 8px;\n  border: 1px solid transparent;\n  border-radius: 999px;\n  background: #ffffff;\n  color: #161616;\n  text-align: left;\n  transition: border-color 120ms ease, background 120ms ease, box-shadow 120ms ease;\n}\n.bank-category-picker-trigger:hover, .bank-category-picker-trigger.open {\n  border-color: #0f62fe;\n  background: #ffffff;\n}\n.bank-category-picker-trigger:focus-visible {\n  outline: 2px solid #0f62fe;\n  outline-offset: 2px;\n}\n.bank-category-picker-value {\n  flex: 1 1 auto;\n  justify-content: center;\n  min-width: 0;\n}\n.bank-category-tag {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 1 auto;\n  width: fit-content;\n  max-width: 100%;\n  min-height: 26px;\n 