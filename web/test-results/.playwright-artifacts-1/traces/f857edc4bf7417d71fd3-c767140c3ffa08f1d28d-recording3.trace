  box-shadow: 0 16px 30px rgba(15, 23, 42, 0.16);\n  transform: translateY(-50%);\n}\n.bank-internal-transfer-tooltip-title {\n  display: block;\n  margin-bottom: 8px;\n  color: #171717;\n  font-weight: 800;\n  line-height: 1.25;\n}\n.bank-internal-transfer-tooltip-grid {\n  display: grid;\n  grid-template-columns: 52px minmax(0, 1fr);\n  gap: 6px 10px;\n  align-items: start;\n}\n.bank-internal-transfer-tooltip-label {\n  color: #71717a;\n  font-weight: 700;\n  line-height: 1.35;\n  white-space: nowrap;\n}\n.bank-internal-transfer-tooltip-value {\n  color: #2f3742;\n  font-weight: 700;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n.bank-internal-transfer-tooltip-amount {\n  font-variant-numeric: tabular-nums;\n}\n.bank-category-hierarchy-tooltip {\n  position: absolute;\n  left: 50%;\n  bottom: calc(100% + 8px);\n  z-index: 60;\n  display: grid;\n  min-width: 180px;\n  max-width: 260px;\n  padding: 10px 12px;\n  border: 1px solid #d9dee5;\n  border-radius: 8px;\n  background: #ffffff;\n  color: #171717;\n  box-shadow: 0 16px 30px rgba(15, 23, 42, 0.16);\n  transform: translateX(-50%);\n}\n.bank-category-hierarchy-tooltip-anchor {\n  position: relative;\n  display: inline-flex;\n}\n.bank-category-hierarchy-title {\n  display: block;\n  margin-bottom: 8px;\n  color: #171717;\n  font-weight: 800;\n  line-height: 1.25;\n  overflow-wrap: anywhere;\n}\n.bank-category-hierarchy-tree {\n  display: grid;\n  gap: 4px;\n}\n.bank-category-hierarchy-row {\n  display: grid;\n  grid-template-columns: 18px minmax(0, 1fr);\n  gap: 6px;\n  align-items: start;\n}\n.bank-category-hierarchy-branch {\n  color: #71717a;\n  font-size: 12px;\n  font-weight: 800;\n  line-height: 1.4;\n  text-align: center;\n}\n.bank-category-hierarchy-node {\n  color: #2f3742;\n  font-weight: 700;\n  line-height: 1.4;\n  overflow-wrap: anywhere;\n}\n.bank-category-tag.category-tone-holiday-bonus {\n  border-color: #d4bbff;\n  background: #f6f2ff;\n  color: #6929c4;\n}\n.bank-category-tag.category-tone-bonus {\n  border-color: #f1c21b;\n  background: #fff8e1;\n  color: #8a6d00;\n}\n.bank-category-tag.category-tone-tax {\n  border-color: #ff7eb6;\n  background: #fff0f6;\n  color: #9f1853;\n}\n.bank-category-tag.category-tone-social-security {\n  border-color: #08bdba;\n  background: #e5fffd;\n  color: #005d5d;\n}\n.bank-category-tag.category-tone-business, .bank-category-tag.category-tone-default {\n  border-color: #42be65;\n  background: #f0fff4;\n  color: #0e6027;\n}\n.bank-category-picker-icon {\n  flex: 0 0 auto;\n  color: #525252;\n}\n.bank-category-picker-popover {\n  min-width: 280px;\n  max-width: min(420px, calc(100vw - 32px));\n  max-height: min(520px, calc(100vh - 32px));\n  border: 1px solid #d0d7de;\n  border-radius: 4px;\n  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.16);\n}\n.bank-category-picker-menu {\n  max-height: inherit;\n  overflow-y: auto;\n  padding: 4px 0;\n  background: #ffffff;\n}\n.bank-category-picker-section-list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n.bank-category-picker-group {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  min-height: 28px;\n  padding: 6px 12px;\n  background: #f7f8fa;\n  color: #525252;\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.35;\n}\n.bank-category-picker-option {\n  min-height: 38px;\n  padding: 6px 12px;\n  color: #161616;\n  font-size: 13px;\n  line-height: 1.35;\n  white-space: normal;\n}\n.bank-category-picker-option .bank-category-tag {\n  max-width: 100%;\n}\n.bank-category-picker-option[aria-current=\"true\"] {\n  background: #edf5ff;\n}\n.bank-category-picker-option[aria-current=\"true\"]:hover, .bank-category-picker-option:hover {\n  background: #e8e8e8;\n}\n@media (max-width: 980px) {\n  .bank-details-layout {\n    grid-template-columns: 1fr;\n    height: auto;\n    min-height: 0;\n  }\n  .bank-account-tree {\n    overflow: hidden;\n  }\n  .bank-account-list {\n    display: flex;\n    gap: 8px;\n    overflow-x: auto;\n    padding-bottom: 2px;\n  }\n  .bank-account-list > li {\n    flex: 0 0 min(260px, 82vw);\n  }\n  .bank-account-node {\n    min-height: 76px;\n    margin-bottom: 0;\n  }\n  .bank-transaction-panel {\n    padding: 12px;\n  }\n  .bank-transaction-grid {\n    flex: 0 0 auto;\n    height: clamp(420px, calc(100vh - 360px), 620px);\n    min-height: 420px;\n  }\n  .relation-preview-summary {\n    grid-template-columns: 1fr;\n  }\n  .bank-balance-summary {\n    width: 100%;\n    justify-content: space-between;\n  }\n}\n.etc-page {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.etc-filter-bar, .etc-panel-heading, .etc-detail-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n.etc-detail-heading {\n  align-items: flex-start;\n  flex-wrap: wrap;\n}\n.etc-detail-heading h2, .etc-section-heading h3 {\n  margin: 0;\n  color: #172033;\n  font-size: 16px;\n  font-weight: 850;\n}\n.etc-detail-heading p {\n  margin: 5px 0 0;\n  color: #52677a;\n  font-size: 13px;\n  font-weight: 700;\n}\n.etc-detail-title-line, .etc-section-heading {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n}\n.etc-page-content, .etc-reconciliation-workspace-content, .etc-reconciliation-task-content, .etc-dialog-stack {\n  display: grid;\n  gap: 14px;\n  min-width: 0;\n}\n.etc-section-actions, .etc-oa-status-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n}\n.etc-filter-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  justify-content: flex-start;\n  padding: 12px;\n  background: #f9fbfe;\n  border: 1px solid #dbe3ef;\n  border-radius: 8px;\n}\n.etc-page-action-link, .etc-primary-action, .etc-secondary-action, .etc-danger-action, .etc-icon-action, .etc-status-segmented__button {\n  border: 1px solid transparent;\n  border-radius: 6px;\n  font: inherit;\n  font-size: 13px;\n  font-weight: 800;\n  line-height: 1;\n  cursor: pointer;\n  transition: backgroun