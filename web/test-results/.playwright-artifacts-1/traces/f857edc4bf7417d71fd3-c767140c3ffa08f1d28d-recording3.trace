o !important;\n    transition-duration: 1ms !important;\n  }\n}\nbutton, input, select, textarea {\n  font: inherit;\n}\n.page-title {\n  margin: 0;\n  color: var(--fp-ink);\n  font-size: var(--fp-text-display);\n  font-weight: 800;\n  line-height: 1.25;\n}\n.page-description {\n  margin-top: 6px;\n  color: var(--fp-text-secondary);\n  font-size: var(--fp-text-body);\n  line-height: 1.5;\n}\n.page-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--fp-space-3);\n}\n.page-toolbar__group {\n  display: flex;\n  align-items: center;\n  gap: var(--fp-space-2);\n}\n.input-invoice-usage-page {\n  min-width: 0;\n  overflow-x: hidden;\n}\n.input-invoice-usage-actions.page-toolbar {\n  justify-content: flex-end;\n}\n.input-invoice-usage-actions .page-toolbar__group {\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n.input-invoice-usage-content {\n  display: grid;\n  min-width: 0;\n  gap: var(--fp-space-4);\n  overflow-x: hidden;\n}\n.input-invoice-usage-query-toolbar.page-toolbar {\n  justify-content: flex-end;\n}\n.input-invoice-usage-query-toolbar .page-toolbar__group {\n  align-items: flex-end;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n.input-invoice-usage-query-actions {\n  display: flex;\n  width: 100%;\n  align-items: center;\n  justify-content: flex-end;\n  gap: var(--fp-space-2);\n}\n.input-invoice-usage-search {\n  display: grid;\n  width: min(360px, 100%);\n  gap: var(--fp-space-1);\n  color: var(--fp-text-secondary);\n  font-size: var(--fp-text-caption);\n  font-weight: 700;\n}\n.input-invoice-usage-search input {\n  width: 100%;\n  min-height: 34px;\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  background: var(--fp-surface);\n  color: var(--fp-text-primary);\n  font: inherit;\n  font-size: var(--fp-text-body);\n  outline: none;\n  padding: 0 var(--fp-space-3);\n  transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);\n}\n.input-invoice-usage-search input:hover {\n  border-color: var(--fp-border-strong);\n}\n.input-invoice-usage-search input:focus-visible {\n  border-color: var(--fp-primary);\n  box-shadow: 0 0 0 3px var(--fp-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fp-primary) 18%, transparent);\n  }\n}\n.input-invoice-usage-button {\n  display: inline-flex;\n  min-height: 34px;\n  align-items: center;\n  justify-content: center;\n  gap: var(--fp-space-1);\n  border: 1px solid var(--fp-border);\n  border-radius: var(--fp-radius-sm);\n  background: var(--fp-surface);\n  color: var(--fp-text-primary);\n  cursor: pointer;\n  font-size: var(--fp-text-body);\n  font-weight: 700;\n  line-height: 1.2;\n  padding: 0 var(--fp-space-3);\n  transition: background var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-out-quart);\n  white-space: nowrap;\n}\n.input-invoice-usage-button:hover:not(:disabled), .input-invoice-usage-button:focus-visible {\n  border-color: var(--fp-primary);\n  background: var(--fp-primary-soft);\n  color: var(--fp-primary-hover);\n  outline: none;\n}\n.input-invoice-usage-button:focus-visible {\n  box-shadow: 0 0 0 3px var(--fp-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fp-primary) 18%, transparent);\n  }\n}\n.input-invoice-usage-button:active:not(:disabled) {\n  transform: translateY(1px);\n}\n.input-invoice-usage-button--primary {\n  border-color: var(--fp-primary);\n  background: var(--fp-primary);\n  color: var(--fp-surface);\n}\n.input-invoice-usage-button--accent {\n  border-color: var(--fp-primary);\n  @supports (color: color-mix(in lab, red, red)) {\n    border-color: colo