: fixed;\n  border-collapse: separate;\n  border-spacing: 0;\n  color: var(--fp-text-primary);\n  font-size: var(--fp-text-label);\n}\n.input-invoice-usage-col-invoice-no {\n  width: 11%;\n}\n.input-invoice-usage-col-seller, .input-invoice-usage-col-invoice-amount {\n  width: 10%;\n}\n.input-invoice-usage-col-business, .input-invoice-usage-col-payment, .input-invoice-usage-col-bank-name {\n  width: 11%;\n}\n.input-invoice-usage-col-oa-applicant {\n  width: 8%;\n}\n.input-invoice-usage-col-oa-project {\n  width: 9%;\n}\n.input-invoice-usage-col-bank-amount {\n  width: 7%;\n}\n.input-invoice-usage-col-bank-remark {\n  width: 12%;\n}\n.input-invoice-usage-table-group-header, .input-invoice-usage-table-sub-header {\n  border-bottom: 1px solid var(--fp-border);\n  color: var(--fp-text-primary);\n  font-weight: 900;\n  line-height: 1.25;\n  padding: 9px var(--fp-table-cell-padding-x);\n  text-align: center;\n  vertical-align: middle;\n  white-space: nowrap;\n}\n.input-invoice-usage-table thead tr:first-child th {\n  position: sticky;\n  top: 0;\n  z-index: 8;\n}\n.input-invoice-usage-table thead tr:nth-child(2) th {\n  position: sticky;\n  top: 38px;\n  z-index: 7;\n  background: var(--fp-table-header-bg);\n}\n.input-invoice-usage-table-group-header {\n  font-size: var(--fp-text-body);\n}\n.input-invoice-usage-table-sub-header {\n  color: var(--fp-text-secondary);\n  font-size: var(--fp-text-label);\n  text-align: center;\n}\n.input-invoice-usage-table-sub-header--right {\n  text-align: right;\n}\n.input-invoice-usage-table-sub-header--center {\n  text-align: center;\n}\n.input-invoice-usage-table-header-stack {\n  display: inline-flex;\n  max-width: 100%;\n  min-width: 0;\n  min-height: 32px;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n  gap: 1px;\n  text-align: center;\n}\n.input-invoice-usage-table-group-header--invoice {\n  background: var(--fp-success-soft);\n  @supports (color: color-mix(in lab, red, red)) {\n    background: color