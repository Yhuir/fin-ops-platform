[Unit]
Description=fin-ops platform API
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=fin-ops
Group=fin-ops
WorkingDirectory=/opt/fin-ops/releases/REPLACE_WITH_RELEASE/src
Environment=PYTHONPATH=/opt/fin-ops/releases/REPLACE_WITH_RELEASE/src/backend/src
Environment=FIN_OPS_DATA_DIR=/opt/fin-ops/data
EnvironmentFile=/etc/fin-ops/fin-ops.common.env
EnvironmentFile=/etc/fin-ops/fin-ops.secrets.env
ExecStart=/opt/fin-ops/venv/bin/python -m fin_ops_platform.app.main --host 127.0.0.1 --port 18001
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fin-ops/data
UMask=0077

[Install]
WantedBy=multi-user.target
