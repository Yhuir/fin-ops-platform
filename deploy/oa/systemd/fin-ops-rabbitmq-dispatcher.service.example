[Unit]
Description=fin-ops RabbitMQ outbox dispatcher
After=network-online.target postgresql.service rabbitmq-server.service
Wants=network-online.target

[Service]
Type=simple
User=fin-ops
Group=fin-ops
WorkingDirectory=/opt/fin-ops/releases/REPLACE_WITH_RELEASE/src
Environment=PYTHONPATH=/opt/fin-ops/releases/REPLACE_WITH_RELEASE/src/backend/src
Environment=FIN_OPS_DATA_DIR=/opt/fin-ops/data
Environment=RABBITMQ_DISPATCHER_POLL_INTERVAL_SECONDS=0.05
EnvironmentFile=/etc/fin-ops/fin-ops.common.env
EnvironmentFile=/etc/fin-ops/fin-ops.secrets.env
EnvironmentFile=/etc/fin-ops/fin-ops.rabbitmq-dispatcher.env
ExecStart=/opt/fin-ops/venv/bin/python -m fin_ops_platform.app.rabbitmq_dispatcher --publisher-id rabbitmq-dispatcher-1 --batch-size 100 --lock-timeout-seconds 300 --retry-delay-seconds 60 --poll-interval-seconds ${RABBITMQ_DISPATCHER_POLL_INTERVAL_SECONDS}
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fin-ops/data
UMask=0077

[Install]
WantedBy=multi-user.target
