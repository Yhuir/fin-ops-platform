[Unit]
Description=fin-ops RabbitMQ topology bootstrap
After=network-online.target rabbitmq-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=fin-ops
Group=fin-ops
WorkingDirectory=/opt/fin-ops/releases/REPLACE_WITH_RELEASE/src
Environment=PYTHONPATH=/opt/fin-ops/releases/REPLACE_WITH_RELEASE/src/backend/src
EnvironmentFile=/etc/fin-ops/fin-ops.common.env
EnvironmentFile=/etc/fin-ops/fin-ops.rabbitmq-topology.env
ExecStart=/opt/fin-ops/venv/bin/python -m fin_ops_platform.app.rabbitmq_topology --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fin-ops/data
UMask=0077

[Install]
WantedBy=multi-user.target
