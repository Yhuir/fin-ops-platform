# Turnover ledger SQL read model refresh worker.
#
# Required for /api/turnover-ledger to leave read_model_status=refreshing after
# bank category confirmations, turnover relation changes, and tag setting changes.
FIN_OPS_QUEUE_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.secrets.env.
# Do not set it in this instance file, otherwise a copied placeholder can
# override the production secret for this worker only.
FIN_OPS_WORKER_KIND=turnover-ledger-read-model
FIN_OPS_WORKER_ARGS="--enable-turnover-ledger-read-model-refresh --event-type turnover_ledger.read_model.refresh"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=12
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=180
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
