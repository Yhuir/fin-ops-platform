# Workbench all-scope aggregate refresh worker.
#
# This worker only claims `scope_key=all` Workbench aggregate events so slow
# cross-month aggregation cannot block month-shard refreshes used by first-screen pages.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=workbench-aggregate-read-model
FIN_OPS_WORKER_ARGS="--enable-workbench-read-model-refresh --event-type workbench.read_model.refresh --claim-scope-key all --poll-interval-seconds 0.25"
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=180
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=150
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=1
