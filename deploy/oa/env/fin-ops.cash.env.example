# API only; install /etc/fin-ops/fin-ops.cash.env as root:root 0600.
# Same PostgreSQL database as the ordinary app, different cash-only LOGIN role.
# Never put this in the common/worker env, never use the ordinary runtime DSN.
FIN_OPS_CASH_POSTGRES_DATABASE_URL=postgresql://REPLACE_CASH_ROLE:REPLACE_SECRET@127.0.0.1:5432/fin_ops
