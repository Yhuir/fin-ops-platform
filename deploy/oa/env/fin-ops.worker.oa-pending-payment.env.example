# OA pending-payment PostgreSQL-only read model worker.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=oa-pending-payment-read-model
FIN_OPS_WORKER_ARGS="--enable-oa-pending-payment-read-model-refresh --event-type oa_pending_payment.read_model.refresh --poll-interval-seconds 0.05"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=60
