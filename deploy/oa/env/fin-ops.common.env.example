# Non-secret fin-ops runtime defaults. Copy to /etc/fin-ops/fin-ops.common.env.
FIN_OPS_APP_STORAGE_BACKEND=postgres
FIN_OPS_APP_READ_BACKEND=postgres
FIN_OPS_POSTGRES_CUTOVER_PHASE=postgres_primary
FIN_OPS_STORAGE_MODE=postgres
FIN_OPS_QUEUE_BACKEND=postgres

FIN_OPS_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
FIN_OPS_POSTGRES_STATEMENT_TIMEOUT_MS=10000
FIN_OPS_POSTGRES_POOL_MIN_SIZE=1
FIN_OPS_POSTGRES_POOL_MAX_SIZE=6
FIN_OPS_POSTGRES_POOL_ACQUIRE_TIMEOUT_SECONDS=2
FIN_OPS_POSTGRES_POOL_MAX_WAITING=16
FIN_OPS_POSTGRES_POOL_ENABLED=1

# Workbench generation retention maintenance policy.
FINOPS_WORKBENCH_PRUNE_KEEP_RECENT=1
FINOPS_WORKBENCH_PRUNE_KEEP_DAYS=0
FINOPS_WORKBENCH_PRUNE_LIMIT=500
FINOPS_WORKBENCH_PRUNE_DELETE_BATCH_SIZE=1
FINOPS_WORKBENCH_PRUNE_STATEMENT_TIMEOUT_SECONDS=60

# Optional read-only pool. Used only when FIN_OPS_POSTGRES_READ_DATABASE_URL is set.
FIN_OPS_POSTGRES_READ_POOL_MIN_SIZE=1
FIN_OPS_POSTGRES_READ_POOL_MAX_SIZE=8
FIN_OPS_POSTGRES_READ_POOL_ACQUIRE_TIMEOUT_SECONDS=2
FIN_OPS_POSTGRES_READ_POOL_MAX_WAITING=16
FIN_OPS_POSTGRES_READ_POOL_ENABLED=1

# One bounded gthread worker keeps the current process-local command state coherent.
# Gunicorn still provides queue bounds, graceful lifecycle and worker recycling.
FIN_OPS_HTTP_BIND=127.0.0.1:18001
FIN_OPS_HTTP_PIDFILE=/run/fin-ops/gunicorn.pid
FIN_OPS_HTTP_WORKERS=1
FIN_OPS_HTTP_THREADS=10
FIN_OPS_HTTP_BACKLOG=128
FIN_OPS_HTTP_TIMEOUT_SECONDS=120
FIN_OPS_HTTP_GRACEFUL_TIMEOUT_SECONDS=30
FIN_OPS_HTTP_KEEPALIVE_SECONDS=5
FIN_OPS_HTTP_MAX_REQUESTS=5000
FIN_OPS_HTTP_MAX_REQUESTS_JITTER=500
FIN_OPS_HTTP_JSON_BODY_MAX_BYTES=2097152
FIN_OPS_HTTP_MULTIPART_BODY_MAX_BYTES=134217728
FIN_OPS_HTTP_OTHER_BODY_MAX_BYTES=8388608
FIN_OPS_MULTIPART_MAX_PARTS=128
FIN_OPS_MULTIPART_MAX_FILES=64
FIN_OPS_UPLOAD_FILE_MAX_BYTES=125829120
FIN_OPS_MULTIPART_FIELD_MAX_BYTES=262144

FIN_OPS_REDIS_KEY_PREFIX=finops
FIN_OPS_REDIS_WAKEUP_CHANNEL=finops:runtime:wakeup
FIN_OPS_REDIS_DEFAULT_TTL_SECONDS=60

FIN_OPS_OA_BASE_URL=https://www.yn-sourcing.com/oa-api
FIN_OPS_OA_USER_INFO_PATH=/system/user/getInfo
FIN_OPS_OA_LOGIN_PATH=/auth/login
FIN_OPS_OA_REQUIRED_PERMISSION=finops:app:view
FIN_OPS_OA_REQUEST_TIMEOUT_MS=5000
FIN_OPS_OA_LOGIN_REQUEST_TIMEOUT_MS=5000
FIN_OPS_OA_SESSION_CACHE_TTL_SECONDS=30

# APP admission comes only from the canonical Settings ACL. Environment allowlists are retired.
# Administrator is fixed by the settings-access-control-v1 contract.

# Optional standalone controlled write-operation E2E inputs. Automatic release gates
# never consume these or mutate production business relations. The scenario file is
# generated on the target host by write_operation_scenario_discovery and stays root-only.
FIN_OPS_WRITE_E2E_SCENARIO=/opt/fin-ops/runtime-smoke/write-operation-e2e-scenarios.json
FIN_OPS_WRITE_E2E_APPROVAL_TICKET=FINOPS-WRITE-SMOKE-STANDING-20260702

RABBITMQ_VHOST=/finops
RABBITMQ_EXCHANGE=finops.events
RABBITMQ_QUEUE_PREFIX=finops
RABBITMQ_DEAD_LETTER_EXCHANGE=finops.events.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_PUBLISH_CONFIRM=true
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_BLOCKED_CONNECTION_TIMEOUT_SECONDS=300
RABBITMQ_MANAGEMENT_TIMEOUT_SECONDS=2
