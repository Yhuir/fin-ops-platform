# OA Mongo -> PostgreSQL projection sync worker.
#
# This is the default production correctness path. It consumes `oa.sync`
# from PostgreSQL `job.outbox_events`; RabbitMQ is not required.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=oa-sync
FIN_OPS_WORKER_ARGS="--enable-oa-sync --event-type oa.sync --poll-interval-seconds 2"
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=4

