FIN_OPS_QUEUE_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.secrets.env.
FIN_OPS_WORKER_KIND=workbench-read-model
FIN_OPS_WORKER_ARGS="--enable-workbench-read-model-refresh --event-type workbench.read_model.refresh"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
