FIN_OPS_QUEUE_BACKEND=rabbitmq
FIN_OPS_IMPORT_PROCESSING_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.rabbitmq-worker.env.
FIN_OPS_WORKER_ID=worker-import-1
FIN_OPS_WORKER_KIND=import-job
FIN_OPS_WORKER_ARGS=--enable-import-job-processing --event-type import.process.requested
FIN_OPS_WORKER_LOCK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=900
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_MAX_ATTEMPTS=5
