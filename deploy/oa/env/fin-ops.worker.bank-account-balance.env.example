# Bank account balance SQL read model refresh worker.
#
# Optional by default. Enable when bank account balance freshness must be
# managed as a continuously running worker instead of via the backfill helper.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=bank-account-balance-read-model
FIN_OPS_WORKER_ARGS="--enable-bank-account-balance-read-model-refresh --event-type bank_account_balance.read_model.refresh --poll-interval-seconds 5"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=4
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
