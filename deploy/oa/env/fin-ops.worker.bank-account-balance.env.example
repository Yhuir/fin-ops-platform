# Bank account balance SQL read model refresh worker.
#
# Required for /api/bank-details/accounts to keep account balances fresh after
# bank transaction imports, deletes, reimports, or raw balance changes.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=bank-account-balance-read-model
FIN_OPS_WORKER_ARGS="--enable-bank-account-balance-read-model-refresh --event-type bank_account_balance.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=4
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
