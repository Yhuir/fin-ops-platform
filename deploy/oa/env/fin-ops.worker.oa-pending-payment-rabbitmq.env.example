FIN_OPS_QUEUE_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.rabbitmq-worker.env.
FIN_OPS_WORKER_KIND=oa-pending-payment-read-model
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=60
FIN_OPS_WORKER_ARGS="--enable-oa-pending-payment-read-model-refresh --event-type oa_pending_payment.read_model.refresh"
