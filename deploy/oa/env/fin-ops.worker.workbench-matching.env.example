# DB-backed dirty scope worker for automatic OA / bank / invoice matching decisions.
# This worker consumes job.workbench_matching_dirty_scopes directly. It is not an
# outbox/RabbitMQ read-model refresh worker, so keep FIN_OPS_QUEUE_BACKEND=postgres.
FIN_OPS_APP_STORAGE_BACKEND=postgres
FIN_OPS_APP_READ_BACKEND=postgres
FIN_OPS_POSTGRES_CUTOVER_PHASE=postgres_primary
FIN_OPS_STORAGE_MODE=postgres
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=workbench-matching
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=1
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=900
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_ARGS="--enable-workbench-matching --workbench-matching-batch-size 10 --workbench-matching-lease-seconds 600 --workbench-matching-retry-delay-seconds 60 --poll-interval-seconds 5"
