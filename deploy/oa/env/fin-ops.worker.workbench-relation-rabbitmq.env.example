# Workbench relation distribution read model refresh worker.
#
# RabbitMQ transport variant. RABBITMQ_URL is loaded from
# /etc/fin-ops/fin-ops.secrets.env.
FIN_OPS_QUEUE_BACKEND=rabbitmq
FIN_OPS_WORKER_KIND=workbench-relation-read-model
FIN_OPS_WORKER_ARGS="--enable-workbench-relation-read-model-refresh --event-type workbench_relation.read_model.refresh"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=24
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=180
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
