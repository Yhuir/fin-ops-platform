# Secret runtime values. Copy to /etc/fin-ops/fin-ops.secrets.env with 0600 root:fin-ops or stricter.
FIN_OPS_POSTGRES_DATABASE_URL=postgresql://fin_ops_worker:CHANGE_ME@127.0.0.1:5432/fin_ops
# Optional read-only DSN for API read models. Leave unset to reuse FIN_OPS_POSTGRES_DATABASE_URL.
# FIN_OPS_POSTGRES_READ_DATABASE_URL=postgresql://fin_ops_reader:CHANGE_ME@127.0.0.1:5432/fin_ops
FIN_OPS_REDIS_URL=redis://127.0.0.1:6379/0

# OA applicant credential storage and target-applicant login. The credential key must be stable across restarts.
FIN_OPS_OA_APPLICANT_CREDENTIAL_KEY=CHANGE_ME_LONG_RANDOM_SECRET
FIN_OPS_OA_LOGIN_RSA_PUBLIC_KEY=CHANGE_ME_OA_LOGIN_PUBLIC_KEY_PEM_OR_BASE64_DER

# Optional legacy app Mongo/GridFS source. Required only for file_object.gridfs_migration workers.
FIN_OPS_APP_MONGO_HOST=127.0.0.1
FIN_OPS_APP_MONGO_PORT=27017
FIN_OPS_APP_MONGO_DATABASE=fin_ops
FIN_OPS_APP_MONGO_USERNAME=CHANGE_ME
FIN_OPS_APP_MONGO_PASSWORD=CHANGE_ME
FIN_OPS_APP_MONGO_AUTH_SOURCE=admin
FIN_OPS_APP_MONGO_TIMEOUT_MS=5000

# Optional OA Mongo source. Required only for oa.sync workers.
FIN_OPS_OA_MONGO_HOST=127.0.0.1
FIN_OPS_OA_MONGO_PORT=27017
FIN_OPS_OA_MONGO_DATABASE=smart_oa
FIN_OPS_OA_MONGO_USERNAME=CHANGE_ME
FIN_OPS_OA_MONGO_PASSWORD=CHANGE_ME
FIN_OPS_OA_MONGO_AUTH_SOURCE=admin
FIN_OPS_OA_MONGO_COLLECTION=form_data
FIN_OPS_OA_MONGO_TIMEOUT_MS=5000
FIN_OPS_OA_MONGO_CACHE_TTL_SECONDS=30
FIN_OPS_OA_PAYMENT_FORM_ID=2
FIN_OPS_OA_EXPENSE_FORM_ID=32
FIN_OPS_OA_PROJECT_FORM_ID=17

# Optional object storage.
OBJECT_STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=fin-ops-files
S3_REGION=cn-north-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Optional OA role sync.
FIN_OPS_OA_ROLE_SYNC_ENABLED=0
FIN_OPS_OA_ROLE_SYNC_HOST=127.0.0.1
FIN_OPS_OA_ROLE_SYNC_PORT=3306
FIN_OPS_OA_ROLE_SYNC_DATABASE=smart_oa
FIN_OPS_OA_ROLE_SYNC_USERNAME=CHANGE_ME
FIN_OPS_OA_ROLE_SYNC_PASSWORD=CHANGE_ME
