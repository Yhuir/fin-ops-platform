# Workbench SQL read model refresh worker.
#
# This is the default production correctness path. It consumes
# `workbench.read_model.refresh` from PostgreSQL `job.outbox_events`;
# RabbitMQ is not required.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=workbench-read-model
FIN_OPS_WORKER_ARGS="--enable-workbench-read-model-refresh --event-type workbench.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8

