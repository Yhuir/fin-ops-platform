# Bank-flow canonical draft owner.
#
# Rebuilds app.bank_flow_rule_batches/app.bank_flow_rule_batch_events after
# bank facts, effective tag rules, settings reset, or repair/replay triggers.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=bank-flow-rule-batch-canonical-draft
FIN_OPS_WORKER_ARGS="--enable-bank-flow-rule-batch-canonical-draft-refresh --event-type bank_flow_rule_batch.canonical_draft.refresh --poll-interval-seconds 0.05"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=24
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
