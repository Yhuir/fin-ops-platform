# Bank-flow rule batch SQL read model refresh worker.
#
# Required for /api/bank-flow-rule-batches to converge after tag rule
# changes and bank-flow rule batch mutations.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=bank-flow-rule-batch-read-model
FIN_OPS_WORKER_ARGS="--enable-bank-flow-rule-batch-read-model-refresh --event-type bank_flow_rule_batch.read_model.refresh --poll-interval-seconds 0.05"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=24
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
