# Search and pending invoice SQL read model refresh worker.
#
# Consumes durable PostgreSQL outbox events for search and pending invoice pages.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=search-pending-read-model
FIN_OPS_WORKER_ARGS="--enable-search-read-model-refresh --enable-pending-invoice-read-model-refresh --event-type search.read_model.refresh --event-type pending_invoice.read_model.refresh --poll-interval-seconds 0.05"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
