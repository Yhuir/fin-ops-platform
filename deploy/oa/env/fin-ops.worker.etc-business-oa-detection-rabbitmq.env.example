FIN_OPS_QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://finops_worker:CHANGE_ME@127.0.0.1:5672/%2Ffinops
FIN_OPS_WORKER_KIND=etc-business-oa-detection
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=60
FIN_OPS_WORKER_ARGS="--enable-etc-business-oa-detection --event-type etc_business.oa_detection.refresh"
