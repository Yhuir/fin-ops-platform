# Shared RabbitMQ worker credential loaded by fin-ops-worker@.service.
#
# This file must not set FIN_OPS_QUEUE_BACKEND. Keep PostgreSQL polling as the
# default transport until a specific /etc/fin-ops/fin-ops.worker.<instance>.env
# is switched to FIN_OPS_QUEUE_BACKEND=rabbitmq during gray rollout.
RABBITMQ_URL=amqp://finops_worker:CHANGE_ME@127.0.0.1:5672/%2Ffinops
RABBITMQ_CONSUMER_POSTGRES_DRAIN_INTERVAL_SECONDS=1
