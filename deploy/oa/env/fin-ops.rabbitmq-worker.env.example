# Apply to one worker instance during gray rollout after shadow publish is healthy.
FIN_OPS_QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://finops_worker:CHANGE_ME@127.0.0.1:5672/%2Ffinops
FIN_OPS_WORKER_KIND=workbench-read-model
FIN_OPS_WORKER_ARGS="--enable-workbench-read-model-refresh --event-type workbench.read_model.refresh"
