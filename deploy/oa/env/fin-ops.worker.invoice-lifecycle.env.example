# Invoice lifecycle SQL read model worker.
#
# Materializes lifecycle policy decisions before downstream invoice pages refresh.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=invoice-lifecycle-read-model
FIN_OPS_WORKER_ARGS="--enable-invoice-lifecycle-read-model-refresh --event-type invoice_lifecycle.read_model.refresh --poll-interval-seconds 0.05"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
