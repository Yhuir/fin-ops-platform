# Bank detail read model worker.
#
# Required for /api/bank-details/accounts and /api/bank-details/transactions
# to leave read_model_status=refreshing after schema/projection changes,
# bank imports, and automatic tag rule changes.
FIN_OPS_QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://finops_worker:CHANGE_ME@127.0.0.1:5672/%2Ffinops
FIN_OPS_WORKER_KIND=bank-detail-read-model
FIN_OPS_WORKER_ARGS="--enable-bank-detail-read-model-refresh --event-type bank_detail.read_model.refresh"
