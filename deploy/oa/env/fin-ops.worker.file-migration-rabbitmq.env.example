FIN_OPS_QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://finops_worker:CHANGE_ME@127.0.0.1:5672/%2Ffinops
FIN_OPS_WORKER_KIND=file-object-migration
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=60
# Requires FIN_OPS_APP_MONGO_* and object storage secrets in /etc/fin-ops/fin-ops.secrets.env or this instance env.
FIN_OPS_WORKER_ARGS="--enable-file-object-migration --event-type file_object.gridfs_migration"
