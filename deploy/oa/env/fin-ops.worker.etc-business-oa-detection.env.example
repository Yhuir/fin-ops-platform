# ETC business batch OA detection worker.
#
# Consumes durable `etc_business.oa_detection.refresh` events after ETC OA
# drafts are created. The API process must not poll OA from in-process threads.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=etc-business-oa-detection
FIN_OPS_WORKER_ARGS="--enable-etc-business-oa-detection --event-type etc_business.oa_detection.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=60
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=4
