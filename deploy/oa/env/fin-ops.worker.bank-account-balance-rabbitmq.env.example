FIN_OPS_QUEUE_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.rabbitmq-worker.env.
FIN_OPS_WORKER_KIND=bank-account-balance-read-model
FIN_OPS_WORKER_ARGS="--enable-bank-account-balance-read-model-refresh --event-type bank_account_balance.read_model.refresh"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=4
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
