FIN_OPS_QUEUE_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.rabbitmq-worker.env.
FIN_OPS_WORKER_KIND=search-pending-read-model
FIN_OPS_WORKER_ARGS="--enable-search-read-model-refresh --enable-pending-invoice-read-model-refresh --event-type search.read_model.refresh --event-type pending_invoice.read_model.refresh"
