# Cost statistics and tax offset SQL read model refresh worker.
#
# Keeps cost statistics and tax offset pages converged through PostgreSQL
# durable queue events.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=cost-tax-read-model
FIN_OPS_WORKER_ARGS="--enable-cost-statistics-read-model-refresh --enable-tax-offset-read-model-refresh --event-type cost_statistics.read_model.refresh --event-type tax_offset.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
