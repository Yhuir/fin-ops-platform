# Tax offset SQL read model refresh compatibility worker.
#
# Keeps the tax offset page converged through PostgreSQL durable queue events.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=cost-tax-read-model
FIN_OPS_WORKER_ARGS="--enable-tax-offset-read-model-refresh --event-type tax_offset.read_model.refresh --poll-interval-seconds 0.25"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
