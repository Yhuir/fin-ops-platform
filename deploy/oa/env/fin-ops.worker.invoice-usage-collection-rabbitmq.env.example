FIN_OPS_QUEUE_BACKEND=rabbitmq
# RABBITMQ_URL is loaded from /etc/fin-ops/fin-ops.rabbitmq-worker.env.
FIN_OPS_WORKER_KIND=invoice-usage-collection-read-model
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=60
FIN_OPS_WORKER_ARGS="--enable-input-invoice-usage-read-model-refresh --enable-output-invoice-collection-read-model-refresh --event-type input_invoice_usage.read_model.refresh --event-type output_invoice_collection.read_model.refresh"
