# Shadow publish mode keeps PostgreSQL polling workers active while publishing envelopes to RabbitMQ.
FIN_OPS_QUEUE_BACKEND=postgres
RABBITMQ_SHADOW_PUBLISH=true
RABBITMQ_DISPATCHER_POLL_INTERVAL_SECONDS=0.5
RABBITMQ_DISPATCH_EVENT_TYPES=workbench.read_model.refresh,workbench_relation.read_model.refresh,search.read_model.refresh,pending_invoice.read_model.refresh,invoice_lifecycle.read_model.refresh,bank_account_balance.read_model.refresh,bank_detail.read_model.refresh,no_oa_bank_batch.read_model.refresh,bank_flow_rule_batch.read_model.refresh,turnover_ledger.read_model.refresh,input_invoice_usage.read_model.refresh,output_invoice_collection.read_model.refresh,oa_pending_payment.read_model.refresh,cost_statistics.read_model.refresh,tax_offset.read_model.refresh,oa.sync,import.process.requested,import.fact.changed
RABBITMQ_URL=amqp://finops_dispatcher:CHANGE_ME@127.0.0.1:5672/%2Ffinops
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_MANAGEMENT_USERNAME=finops_monitor
RABBITMQ_MANAGEMENT_PASSWORD=CHANGE_ME
