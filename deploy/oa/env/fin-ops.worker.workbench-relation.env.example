# Workbench relation distribution read model refresh worker.
#
# Required before downstream pages can read unified OA/bank/invoice relation
# context from read_model.workbench_relation_rows/groups.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=workbench-relation-read-model
FIN_OPS_WORKER_ARGS="--enable-workbench-relation-read-model-refresh --event-type workbench_relation.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=24
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=180
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
