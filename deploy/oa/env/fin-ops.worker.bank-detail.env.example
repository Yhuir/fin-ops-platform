# Bank detail SQL read model refresh worker.
#
# Required for bank detail APIs to leave read_model_status=refreshing after
# imports, projection changes, and automatic tag rule changes.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=bank-detail-read-model
FIN_OPS_WORKER_ARGS="--enable-bank-detail-read-model-refresh --event-type bank_detail.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=24
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
