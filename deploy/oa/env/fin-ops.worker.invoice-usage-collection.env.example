# Input invoice usage and output invoice collection SQL read model worker.
#
# Keeps invoice usage/collection read models converged after imports and
# projection schema changes.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=invoice-usage-collection-read-model
FIN_OPS_WORKER_ARGS="--enable-input-invoice-usage-read-model-refresh --enable-output-invoice-collection-read-model-refresh --enable-oa-pending-payment-read-model-refresh --event-type input_invoice_usage.read_model.refresh --event-type output_invoice_collection.read_model.refresh --event-type oa_pending_payment.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=8
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
