# Import job processing worker.
#
# Required when import APIs enqueue job.import_jobs / import.process.requested
# instead of doing heavy import work in the API process.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_IMPORT_PROCESSING_BACKEND=postgres
FIN_OPS_WORKER_KIND=import-job
FIN_OPS_WORKER_ARGS="--enable-import-job-processing --event-type import.process.requested --event-type import.fact.changed --poll-interval-seconds 0.25"
FIN_OPS_WORKER_LOCK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=900
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=2
