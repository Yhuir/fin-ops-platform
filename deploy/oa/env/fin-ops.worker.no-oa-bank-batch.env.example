# No-OA bank batch SQL read model refresh worker.
#
# Required for /api/no-oa-bank-batches to converge after automatic tag rule
# changes and no-OA tag selection changes.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=no-oa-bank-batch-read-model
FIN_OPS_WORKER_ARGS="--enable-no-oa-bank-batch-read-model-refresh --event-type no_oa_bank_batch.read_model.refresh --poll-interval-seconds 2"
FIN_OPS_WORKER_MAX_EVENTS_PER_ITERATION=24
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=120
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=90
