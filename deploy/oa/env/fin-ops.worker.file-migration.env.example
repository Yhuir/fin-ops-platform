# Optional GridFS to object storage migration worker.
#
# Do not include this worker in FINOPS_REQUIRED_WORKERS unless legacy GridFS and
# object storage secrets are configured. It is intentionally optional.
FIN_OPS_QUEUE_BACKEND=postgres
FIN_OPS_WORKER_KIND=file-object-migration
FIN_OPS_WORKER_ARGS="--enable-file-object-migration --event-type file_object.gridfs_migration --poll-interval-seconds 5"
FIN_OPS_WORKER_TASK_TIMEOUT_SECONDS=300
FIN_OPS_WORKER_STATEMENT_TIMEOUT_SECONDS=120
