# fin-ops OA integration
FIN_OPS_OA_BASE_URL=https://oa.company.com
FIN_OPS_OA_USER_INFO_PATH=/system/user/getInfo
FIN_OPS_OA_LOGIN_PATH=/auth/login
FIN_OPS_OA_REQUIRED_PERMISSION=finops:app:view
FIN_OPS_OA_REQUEST_TIMEOUT_MS=5000
FIN_OPS_OA_LOGIN_REQUEST_TIMEOUT_MS=5000
FIN_OPS_OA_SESSION_CACHE_TTL_SECONDS=30
FIN_OPS_OA_APPLICANT_CREDENTIAL_KEY=CHANGE_ME_LONG_RANDOM_SECRET
FIN_OPS_OA_LOGIN_RSA_PUBLIC_KEY=CHANGE_ME_OA_LOGIN_PUBLIC_KEY_PEM_OR_BASE64_DER

# Optional allow-list fallback
FIN_OPS_ALLOWED_USERNAMES=YNSYLP005
FIN_OPS_READONLY_EXPORT_USERNAMES=
FIN_OPS_ADMIN_USERNAMES=YNSYLP005
FIN_OPS_ALLOWED_ROLES=

# Optional automatic OA menu-role sync on access-control save
FIN_OPS_OA_ROLE_SYNC_ENABLED=0
FIN_OPS_OA_ROLE_SYNC_HOST=127.0.0.1
FIN_OPS_OA_ROLE_SYNC_PORT=3306
FIN_OPS_OA_ROLE_SYNC_DATABASE=smart_oa
FIN_OPS_OA_ROLE_SYNC_USERNAME=root
FIN_OPS_OA_ROLE_SYNC_PASSWORD=
FIN_OPS_OA_ROLE_SYNC_CONNECT_TIMEOUT_SECONDS=5
FIN_OPS_OA_ROLE_SYNC_READONLY_ROLE_KEY=finops_read_export
FIN_OPS_OA_ROLE_SYNC_FULL_ACCESS_ROLE_KEY=finops_full_access
FIN_OPS_OA_ROLE_SYNC_ADMIN_ROLE_KEY=finops_admin

# fin-ops frontend
VITE_APP_BASE_PATH=/fin-ops/

# Runtime queue. PostgreSQL remains the task source of truth; RabbitMQ is an optional envelope transport.
FIN_OPS_QUEUE_BACKEND=postgres
RABBITMQ_URL=
RABBITMQ_VHOST=/finops
RABBITMQ_EXCHANGE=finops.events
RABBITMQ_WORKBENCH_QUEUE=finops.workbench.read_model.refresh
RABBITMQ_WORKBENCH_ROUTING_KEY=workbench.read_model.refresh
RABBITMQ_DEAD_LETTER_EXCHANGE=finops.events.dlx
RABBITMQ_WORKBENCH_DEAD_LETTER_QUEUE=finops.workbench.read_model.refresh.dlq
RABBITMQ_PREFETCH=10
RABBITMQ_PUBLISH_CONFIRM=true
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_BLOCKED_CONNECTION_TIMEOUT_SECONDS=300
RABBITMQ_MANAGEMENT_URL=
RABBITMQ_MANAGEMENT_USERNAME=
RABBITMQ_MANAGEMENT_PASSWORD=
RABBITMQ_MANAGEMENT_TIMEOUT_SECONDS=2
RABBITMQ_SHADOW_PUBLISH=false

# Business Mongo and other runtime settings are configured separately.
